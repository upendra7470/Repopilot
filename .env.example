# Database
DATABASE_URL=postgresql://localhost:5432/repopilot

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# CORS (must match the frontend origin; cookies require an exact origin,
# credentials are enabled)
CORS_ORIGIN=http://localhost:5173

# Canonical frontend URL used for post-login redirects
FRONTEND_URL=http://localhost:5173

# Session + credential encryption secret (min 32 chars).
# REQUIRED in production. When absent, the server generates an ephemeral
# per-process secret (sessions do not survive restarts) and logs a warning.
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars

# GitHub OAuth application (https://github.com/settings/developers).
# Homepage URL:      http://localhost:5173
# Authorization callback URL: http://localhost:3001/api/auth/github/callback
# When absent, login endpoints report "not configured" instead of
# authenticating. No fake login is ever performed.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public backend callback URL. Defaults to
# http://localhost:3001/api/auth/github/callback; set explicitly when the
# backend is served from a public domain.
# GITHUB_REDIRECT_URI=https://api.example.com/api/auth/github/callback

# Authenticated session lifetime in hours (default 7 days)
SESSION_TTL_HOURS=168

# GitHub OAuth scopes requested (identity + public repository data):
#   read:user  - read the authenticated user's profile (id, login, name, avatar)
#   user:email - read the user's email addresses (primary email lookup)
# No repository, workflow, admin, or write scopes are requested.
#
# Phase 5 ingestion works for repositories visible to these scopes (public
# repositories). Private repository ingestion requires the classic `repo`
# scope: add it to GITHUB_OAUTH_SCOPES in server/src/routes/auth.ts and have
# users sign in again (stored credentials are replaced on re-login). Until
# then, syncing a private repository returns PRIVATE_REPO_REQUIRES_SCOPE.

# AI PR analysis (Phase 8, all optional — strictly opt-in).
# Any OpenAI-compatible endpoint works. When absent, deterministic PR
# intelligence still works and the UI reports AI as unavailable (never faked).
#   OpenAI:  AI_API_KEY=sk-... (model defaults to gpt-4o-mini)
#   Ollama:  AI_BASE_URL=http://localhost:11434/v1 (keyless; set AI_MODEL)
#   LM Studio: AI_BASE_URL=http://localhost:1234/v1 (keyless; set AI_MODEL)
# AI_PROVIDER=
# AI_MODEL=
# AI_BASE_URL=
# AI_API_KEY=
